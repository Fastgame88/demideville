# Server
PORT=3000

# Railway PostgreSQL (recommended in production)
DATABASE_URL=postgresql://user:password@host:5432/database
# auto = no TLS for *.railway.internal, TLS for public DB URLs
PGSSL=auto
PGPOOL_MAX=5

# Persistent uploads. On Railway attach a Volume and mount it, for example, at /data.
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=60

# SMTP / transactional email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_SECURE=false
MAIL_FROM=DEMI DEVILLE <shop@example.com>
SUPPORT_TO=support@example.com
