# Server
PORT=3000

# Railway PostgreSQL
# In Railway prefer a reference variable instead of pasting the actual password:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=
PGSSL=auto
PGPOOL_MAX=5

# Persistent uploads (Railway Volume mounted to /data)
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=60

# SMTP / email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=DEMI DEVILLE <shop@example.com>
SUPPORT_TO=support@example.com
